# Nerve Configuration

# ─── Server ───────────────────────────────────────────────────────────────────
# HTTP/HTTPS ports
PORT=3080
SSL_PORT=3443

# Bind address — defaults to 127.0.0.1 (localhost only)
# Set to 0.0.0.0 for network/remote access (requires auth — see below)
# HOST=127.0.0.1

# Development: Vite runs on VITE_PORT and proxies /api + /ws to PORT
# VITE_PORT=3080           # Vite dev server port (default: 3080)
# VITE_HOST=127.0.0.1      # Vite dev server bind address (default: 127.0.0.1)

# ─── Agent Identity ──────────────────────────────────────────────────────────
AGENT_NAME=Agent

# ─── OpenClaw Gateway (required) ─────────────────────────────────────────────
# The login password when NERVE_PASSWORD_HASH is unset. The /ws relay does
# not send it.
GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_TOKEN=  # Alternative name for GATEWAY_TOKEN (checked as fallback)
GATEWAY_URL=http://127.0.0.1:18789

# ─── Authentication ──────────────────────────────────────────────────────────
# Enable to require a password for all API/WebSocket access.
# NERVE_AUTH=false
# NERVE_PASSWORD_HASH=                     # scrypt hash, in the form server/lib/session.ts hashPassword() writes
# NERVE_SESSION_SECRET=                    # 32-byte hex for cookie signing
# NERVE_SESSION_TTL=2592000000             # Session lifetime in ms (default: 30 days)

# ─── Security Override ───────────────────────────────────────────────────────
# Setting HOST=0.0.0.0 without auth causes the server to refuse to start.
# Set this to bypass that safety check (NOT recommended for production).
# NERVE_ALLOW_INSECURE=false

# ─── Paths (defaults to ~/.openclaw structure if unset) ──────────────────────
# MEMORY_PATH=~/.openclaw/workspace/MEMORY.md
# MEMORY_DIR=~/.openclaw/workspace/memory

# ─── Speech (read-aloud and voice input) ─────────────────────────────────────
# One OpenAI-shaped endpoint serves both; deploy setup points it at the
# deployment's own speech service (the LiteLLM aliases cc-tts and cc-stt) and
# mints this key scoped to them. Without a key, speech is off.
OPENAI_API_KEY=

# ─── API Base URLs (optional — override for proxies or self-hosted) ──────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=whisper-1               # model name sent to /audio/transcriptions (a proxy alias, e.g. cc-stt); when set, it is the default of Settings > Audio's dictation model picker (the LiteLLM models with mode audio_transcription)
# OPENAI_TTS_MODEL=cc-tts                  # set ONLY when pointing at a deployment's own speech service (a proxy alias): then it is the default read-aloud model, Settings > Audio may choose another model LiteLLM lists with mode audio_speech, a model sent by the browser never applies, and the voice below is sent in place of an OpenAI voice name. Leave unset for api.openai.com
# OPENAI_TTS_VOICE=af_heart                # deployment voice (a self-hosted engine names its own voices; default af_heart); without OPENAI_TTS_MODEL it only seeds the first-run OpenAI voice

# ─── Voice language and phrases ─────────────────────────────────────────────
# NERVE_LANGUAGE=en                        # Preferred voice language (ISO 639-1)
# NERVE_VOICE_PHRASES_PATH=~/.nerve/voice-phrases.json

# ─── TTS Cache ───────────────────────────────────────────────────────────────
# TTS_CACHE_TTL_MS=3600000                 # Cache TTL in ms (default: 1 hour)
# TTS_CACHE_MAX=200                        # Max cached TTS entries (in-memory LRU)

# ─── Network & CORS ─────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://your-server.example.com:3443
# CSP_CONNECT_EXTRA=wss://your-server.example.com:3443 https://your-server.example.com:3443
# WS_ALLOWED_HOSTS=gateway.local,10.0.0.5
# TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
