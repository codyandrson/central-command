web/node_modules/
web/dist/
web/server-dist/
web/bin-dist/

# OS
.DS_Store

# SDD scratch — ledger, briefs, review packages. Never committed.
.superpowers/
.playwright-mcp/
drafts/

# Setup driver litter — the k3s driver's only. The SINGLE-NODE driver and
# deploy/discover.sh write NOTHING inside the checkout since v2.42.0: every
# generated file (logs, diagnostics, installed.manifest, pid files, the
# updater's working dir, discovery's report and evidence) lives in
# $CC_STATE_DIR, outside the tree — design record
# docs/superpowers/specs/2026-09-23-airgap-check-configure-setup-design.md, D7.
# `./deploy/single/setup.sh diagnose` prints that path first. So there is no
# deploy/single/.gitignore any more, and no deploy/discovery.out/ or
# deploy/discovery.conf to ignore: an entry here would only hide a regression.
deploy/k3s/setup-log.txt
deploy/k3s/setup-diagnostics.txt
CLAUDE.local.md

# Windows: `uv run` at the root writes uv.lock; podman hands Git's MSYS ssh
# `UserKnownHostsFile=NUL`, which creates a literal file named NUL.
uv.lock
NUL

# BMad is local tooling (skills + scratch state), not project content.
_bmad/
.claude/skills/bmad-*/

# kubectl's discovery cache, written here when a root systemd unit runs with
# no HOME set (see deploy/k3s/cc-backup.service, cc-update.service).
.kube/
