# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
.env.local

# Database dumps staged by deploy/pi/migrate-from-desktop.sh. These carry real
# data AND encrypted credentials (the n8n dump holds the Gmail OAuth record) —
# never commit them.
deploy/pi/migration/

# Node / web
node_modules/
web/node_modules/
web/dist/
web/server-dist/
web/bin-dist/

# OS
.DS_Store

# SDD scratch — ledger, briefs, review packages. Never committed.
.superpowers/
.playwright-mcp/
drafts/

# Setup driver litter (the k3s driver; deploy/single/ has its own .gitignore)
deploy/k3s/setup-log.txt
deploy/k3s/setup-diagnostics.txt

# Environment discovery output and operator-local config (deploy/discover.sh).
# Both name internal mirror hosts and network posture — never commit them.
deploy/discovery.out/
deploy/discovery.conf
CLAUDE.local.md

# Windows: `uv run` at the root writes uv.lock; podman hands Git's MSYS ssh
# `UserKnownHostsFile=NUL`, which creates a literal file named NUL.
uv.lock
NUL

# BMad is local tooling (skills + scratch state), not project content.
_bmad/
.claude/skills/bmad-*/

# kubectl's discovery cache, written here when a root systemd unit runs with
# no HOME set (see deploy/k3s/cc-backup.service, cc-update.service).
.kube/
