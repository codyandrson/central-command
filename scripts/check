#!/usr/bin/env bash
# The repo's code-quality check: one command, run before a push (the pre-push
# hook, scripts/prepush-scan.sh, calls it) and by hand. Exits non-zero on any
# finding. The ruff version and rule set live in pyproject.toml.
set -euo pipefail
cd "$(dirname "$0")/.."
# The checkout's own virtualenv: the tools come from the `check` extra, pinned
# in pyproject.toml, never from whatever is on PATH.
for tool in ruff mypy; do
  if [[ ! -x ".venv/bin/$tool" ]]; then
    echo "scripts/check: $tool is not installed in $PWD/.venv; run: uv pip install -e \".[dev,runtime,exchange,google,check]\"" >&2
    exit 1
  fi
done
PATH="$PWD/.venv/bin:$PATH"

ruff check .
ruff format --check .
# The type check: mypy over central_command/ (config and the ratchet list of
# modules still ignored: [tool.mypy] in pyproject.toml).
mypy
