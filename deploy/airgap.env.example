# Air-gapped pip/uv mirror seam. NOT CC_*-prefixed (unlike .env.example),
# so it lives here rather than being merged into that file. Export these in
# the shell/CI that runs `pip install` / `uv sync` on the work site; fill in
# the real mirror URLs there.

# PIP_INDEX_URL=https://MIRROR_HOST/pypi/simple
# UV_INDEX_URL=https://MIRROR_HOST/pypi/simple
# UV_PYTHON_INSTALL_MIRROR=https://MIRROR_HOST/python-build-standalone
