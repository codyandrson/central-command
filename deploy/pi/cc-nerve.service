# Central Command Nerve cockpit UI — SYSTEM unit for the Raspberry Pi deployment.
#
# Serves the vendored Nerve web UI (web/) on 127.0.0.1:3080. Config lives in
# web/.env (PORT, GATEWAY_URL -> the FastAPI gateway on 8080, ALLOWED_ORIGINS
# + NERVE_AUTH for the Tailscale Serve origin). Tailnet exposure is handled by
#   tailscale serve --bg http://127.0.0.1:3080
# which persists in tailscaled state and survives reboots on its own — this
# unit only needs the local server.
#
# Install (one time):
#   sudo cp deploy/pi/cc-nerve.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cc-nerve
#
# After `npm run build` in web/, restart this unit to pick up the new bundle.

[Unit]
Description=Central Command Nerve cockpit (node on 127.0.0.1:3080)
After=network-online.target
Wants=network-online.target
# Not Requires= — the UI is useful even while the API restarts; it reconnects.
#
# cc-uvicorn is deliberately NOT in Wants= (dropped 2026-08-26). Wants= is a
# START dependency, so `systemctl start cc-nerve` also started the API — which
# defeated the clean-install runbook's "install the units, do NOT start
# cc-uvicorn before the onboarding interview" and brought the API up 40 minutes
# early under stale env, hiring an agent under the rehearsal persona. Boot is
# unaffected: cc-uvicorn is `enable`d in its own right, so multi-user.target
# pulls it in regardless. Setup-time ordering must not be decided here.

[Service]
User=codyslab
Group=codyslab
WorkingDirectory=/home/codyslab/central-command/web
ExecStart=/usr/bin/node server-dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
