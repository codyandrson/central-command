+# ---------------------------------------------------------------------------
+# Central Command (2026-08-19): a true cross-encoder for hybrid-search reranking.
+#
+# Upstream's default is OpenAIRerankerClient — a boolean-classifier prompt per
+# passage against the CHAT model, which on this deployment meant the 27B chat
+# LLM was doing a purpose-built 0.6B reranker's job, serialized. When
+# GRAPHITI_RERANK_MODEL is set, rerank through LiteLLM's /rerank instead
+# (Jina/Cohere wire shape -> llama.cpp `--rerank` server on the workstation).
+# Unset -> upstream default behaviour, so the escape hatch is deleting one env
+# var. FAILS SOFT at call time: a down reranker returns the passages unranked
+# (input order) rather than killing the search that asked.
+# ---------------------------------------------------------------------------
+from graphiti_core.cross_encoder.client import CrossEncoderClient
+
+
+class GVRerankClient(CrossEncoderClient):
+    def __init__(self, base_url: str, api_key: str, model: str):
+        # base_url is OPENAI_BASE_URL (".../v1" on LiteLLM); /rerank lives at
+        # the proxy ROOT, and llama.cpp itself answers both /rerank and
+        # /v1/rerank — strip the suffix so both directs and LiteLLM work.
+        self._url = base_url.rstrip('/').removesuffix('/v1') + '/rerank'
+        self._api_key = api_key
+        self._model = model
+
+    async def rank(self, query: str, passages: list[str]) -> list[tuple[str, float]]:
+        if not passages:
+            return []
+        import httpx
+
+        try:
+            async with httpx.AsyncClient(timeout=30) as client:
+                resp = await client.post(
+                    self._url,
+                    headers={'Authorization': f'Bearer {self._api_key}'},
+                    json={'model': self._model, 'query': query, 'documents': passages},
+                )
+                resp.raise_for_status()
+                results = resp.json()['results']
+            ranked = sorted(results, key=lambda r: r['relevance_score'], reverse=True)
+            return [(passages[r['index']], float(r['relevance_score'])) for r in ranked]
+        except Exception as exc:  # noqa: BLE001 — degrade, never kill the search
+            logging.getLogger(__name__).warning(
+                'GVRerankClient: rerank via %s failed (%s) — returning input order',
+                self._url,
+                exc,
+            )
+            return [(p, 1.0 - i / max(len(passages), 1)) for i, p in enumerate(passages)]
+
+
+def _cc_cross_encoder() -> CrossEncoderClient | None:
+    model = os.environ.get('GRAPHITI_RERANK_MODEL', '').strip()
+    if not model:
+        return None  # -> graphiti_core default (OpenAIRerankerClient)
+    return GVRerankClient(
+        base_url=os.environ.get('OPENAI_BASE_URL', 'https://api.openai.com/v1'),
+        api_key=os.environ.get('OPENAI_API_KEY', ''),
+        model=model,
+    )
+
