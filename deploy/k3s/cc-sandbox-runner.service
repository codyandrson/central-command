# Sandbox-runner (D-sandbox, slice 1) — SEPARATE from cc-uvicorn on purpose.
#
# This unit runs central_command/sandbox/runner.py, a standalone, credential-free
# FastAPI service that drives ephemeral gVisor Jobs on the chromebox by
# shelling out to kubectl with a namespace-scoped (cc-sandbox) kubeconfig. It
# holds no Postgres connection, no LiteLLM key, no Jira token — see the
# module's own docstring for why that boundary matters.
#
# Install (one time, as a user with sudo):
#   ./deploy/k3s/make-sandbox-kubeconfig.sh   # writes the kubeconfig this unit reads
#   sudo cp deploy/k3s/cc-sandbox-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cc-sandbox-runner
#
# Modeled on deploy/k3s/cc-uvicorn.service. This talks to the cluster on
# every request, not just at startup, so it can do nothing useful without k3s
# up — but that is a per-request failure it reports, not a reason to stay
# down:
#
# Wants=, not Requires= (v2.58.3). Requires= makes this unit's start job
# depend on k3s's start job SUCCEEDING: when k3s loses its first attempt at
# boot (its network not up yet) systemd cancels this unit's start with
# "Dependency failed" — once. k3s retries on its own Restart= and is up a
# minute later; nothing re-queues a cancelled dependent, and Restart=always
# only applies to a unit that has run. The unit then stays dead until someone
# starts it by hand. Wants= + After= still starts k3s with this unit and
# still orders it first, but starts this unit either way —
# a request made before the cluster answers fails and the next one works.

[Unit]
Description=Central Command sandbox-runner (uvicorn on 127.0.0.1:8090)
After=network-online.target k3s.service
Wants=network-online.target k3s.service

[Service]
User=codyslab
Group=codyslab
WorkingDirectory=/home/codyslab/central-command
# .env carries CC_SANDBOX_RUNNER_TOKEN (and any CC_SANDBOX_* overrides) so the
# runner and the app enforce/send the SAME token from the same file.
EnvironmentFile=-/home/codyslab/central-command/.env
Environment=CC_SANDBOX_KUBECONFIG=/home/codyslab/.cc-sandbox-runner.kubeconfig
Environment=CC_SANDBOX_COPY_ROOT=/home/codyslab/central-command
ExecStart=/home/codyslab/central-command/.venv/bin/uvicorn central_command.sandbox.runner:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
