# Loopback-only bolt reachability for the cockpit's graph reads (rung 3 of
# docs/superpowers/specs/2026-08-09-graph-inspection-design.md).
#
# cc-neo4j stays ClusterIP-only; this unit relays 127.0.0.1:7687 (bolt) and
# 127.0.0.1:7474 (Neo4j Browser UI) to the Service's ClusterIP, keeping the
# standing rule that every CC_* endpoint resolves to loopback and adding no
# tailnet/LAN exposure by itself — reaching Browser from the tailnet is an
# explicit tailscale-serve decision on top (https:7474 for the page,
# tls-terminated-tcp:7687 for the bolt websocket Browser opens from the
# client).
#
# Why socat and not `kubectl port-forward` (2026-09-17, v2.36.1): port-forward
# resolves svc/neo4j to ONE pod at start, never re-resolves, and does not exit
# when that pod dies — it only errors on the NEXT client connection
# (kubernetes/kubernetes#67059, kubernetes/kubectl#686, unfixed since 2018).
# The nightly backup replaces the pod (Community Edition can only dump an
# offline store), so the first graph read every morning was a 500 and a red
# toast. socat opens a fresh upstream connection per client connection and
# kube-proxy's host-side rules carry the ClusterIP to whichever pod is
# current — nothing here can go stale. The ClusterIP is looked up once per
# start; it only changes if the Service is deleted and recreated (then
# restart this unit).
#
# Install (mirrors cc-uvicorn.service):
#   sudo apt install socat
#   sudo cp deploy/k3s/cc-graph-bolt.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cc-graph-bolt
[Unit]
Description=Central Command loopback bolt relay to cc-neo4j (read path for the Graph panel)
Requires=k3s.service
After=k3s.service

[Service]
# ponytail: the 7474 relay is a background child of the same shell; the unit
# only tracks the 7687 one. Split into two units if Browser reachability ever
# needs its own restart.
ExecStart=/bin/sh -c 'IP=$(/usr/local/bin/k3s kubectl -n central-command get svc neo4j -o jsonpath={.spec.clusterIP}) && [ -n "$IP" ] && echo "relaying 127.0.0.1:7687,7474 -> $IP" && socat TCP-LISTEN:7474,bind=127.0.0.1,fork,reuseaddr TCP:$IP:7474 & exec socat TCP-LISTEN:7687,bind=127.0.0.1,fork,reuseaddr TCP:$IP:7687'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
