# ============================================================================
# Central Command — SINGLE-NODE profile, THE LiteLLM HALF.
#
#   Split out of stack.yaml.tmpl on 2026-08-25 (LiteLLM-first setup, the operator's
#   decision): the proxy comes up EARLY, its aliases are registered, and every
#   validation probe then runs THROUGH those aliases — so what setup proves is
#   what production uses. The core stack (postgres, neo4j, graphiti) follows in
#   stack.yaml, because the graph must not be created before the embedding
#   DIMENSION has been measured through cc-embedding.
#
#   That ordering is the whole reason for the split, and it is the one rule to
#   keep: NOTHING in this file may reference ${CC_EMBED_DIM}. render.sh renders
#   this file without requiring it.
#
#   Play order:      secrets.yaml -> stack-llm.yaml -> stack.yaml
#   Teardown order:  stack.yaml -> stack-llm.yaml (this file LAST)
#
#   Everything else — pod name IS the DNS name, hostPort on 127.0.0.1, no
#   Services, no probes — is documented in stack.yaml.tmpl's header and applies
#   here unchanged.
# ============================================================================
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${CC_POD_PREFIX}litellm-config
data:
  config.yaml: |
    # LiteLLM for the single-node profile.
    #
    # FOUR model entries and nothing else. The homelab config keeps its
    # models in Postgres (store_model_in_db) and points them at the operator's
    # workstation; a giftable install has neither, so the models live here
    # and point at the endpoint the user supplied at setup.
    #
    # Keys are `os.environ/...` refs, never literals — this ConfigMap is
    # rendered into a file that may be read by anyone who can read the
    # install dir, while the secret lives in a podman secret.
    model_list:
      # What Central Command's agents address. The spine knows exactly one alias.
      - model_name: cc-default
        litellm_params:
          model: openai/${CC_CHAT_MODEL}
          api_base: ${CC_LLM_BASE_URL}
          api_key: os.environ/CC_LLM_API_KEY

      # NOT a duplicate of cc-default, and the prefix is the whole point.
      #
      # graphiti_core's OpenAIClient drives extraction through the RESPONSES
      # API (`client.responses.parse`) whenever a response_model is present —
      # always, for extraction, with no chat-completions fallback. LiteLLM
      # treats a plain `openai/...` model as NATIVELY supporting /v1/responses
      # and passes the request straight through, so an OpenAI-COMPATIBLE
      # endpoint that does not implement it silently DROPS the
      # `text.format` json_schema and the model answers prose. Every
      # extraction then fails.
      #
      # `openai/chat_completions/` forces LiteLLM's Responses -> chat bridge,
      # which turns text.format into a real `response_format: json_schema`.
      # Upstream says the same thing about local/compatible endpoints. Keep
      # this prefix even when it looks redundant against cc-default.
      - model_name: graphiti-llm
        litellm_params:
          model: openai/chat_completions/${CC_CHAT_MODEL}
          api_base: ${CC_LLM_BASE_URL}
          api_key: os.environ/CC_LLM_API_KEY

      # The embedder. Its DIMENSION is configuration (CC_EMBED_DIM),
      # discovered at setup and written into the graphiti config below —
      # never the hardcoded 1024 the homelab carries. Changing the embedder
      # later means dropping the vector index and re-embedding the whole
      # graph, so treat it as permanent, not a tunable.
      #
      # This is the ONE alias that may point somewhere else: a self-hosted
      # install commonly serves chat and embeddings from different servers.
      # CC_EMBED_BASE_URL / CC_EMBED_API_KEY default to the main pair when
      # unset, so a single-endpoint install renders exactly as before.
      - model_name: cc-embedding
        litellm_params:
          model: openai/${CC_EMBED_MODEL}
          api_base: ${CC_EMBED_BASE_URL}
          api_key: os.environ/CC_EMBED_API_KEY

      # graphiti_core's default reranker (OpenAIRerankerClient, built
      # unconditionally with no config) addresses a model LITERALLY named
      # gpt-4.1-nano — the live k3s deployment registers this same alias for
      # the same reason. It runs a logprob-classifier over chat completions,
      # so any chat model serves; endpoints that don't return logprobs
      # degrade rerank quality, they don't break search.
      - model_name: gpt-4.1-nano
        litellm_params:
          model: openai/${CC_CHAT_MODEL}
          api_base: ${CC_LLM_BASE_URL}
          api_key: os.environ/CC_LLM_API_KEY

    general_settings:
      master_key: os.environ/LITELLM_MASTER_KEY
      database_url: os.environ/DATABASE_URL
      store_model_in_db: true
      background_health_checks: false

    litellm_settings:
      request_timeout: 300
      # The user's endpoint may not accept every param LiteLLM would send.
      drop_params: true
      cache: true
      cache_params:
        type: redis
        host: os.environ/REDIS_HOST
        port: os.environ/REDIS_PORT

    router_settings:
      allowed_fails: 1
      # Every alias has exactly one deployment here, so a cooldown converts a
      # single failed request into a total outage reported as the misleading
      # "No deployments available for selected model".
      cooldown_time: 0
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${CC_POD_PREFIX}litellm-pgdata
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${CC_POD_PREFIX}litellm-redisdata
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}litellm-db
  labels:
    app: ${CC_POD_PREFIX}litellm-db
spec:
  restartPolicy: Always
  containers:
    - name: postgres
      image: ${CC_REGISTRY_DOCKERIO}/library/postgres:16
      env:
        - name: POSTGRES_DB
          value: litellm
        - name: POSTGRES_USER
          value: llmproxy
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: LITELLM_POSTGRES_PASSWORD}
        - name: PGDATA
          value: /var/lib/postgresql/data/pgdata
      ports:
        - containerPort: 5432
          hostPort: ${CC_LITELLM_DB_PORT}
          hostIP: 127.0.0.1
      volumeMounts:
        - name: data
          mountPath: /var/lib/postgresql/data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: ${CC_POD_PREFIX}litellm-pgdata
---
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}litellm-redis
  labels:
    app: ${CC_POD_PREFIX}litellm-redis
spec:
  restartPolicy: Always
  containers:
    - name: redis
      image: ${CC_REGISTRY_DOCKERIO}/library/redis:7-alpine
      args: ["redis-server", "--save", "60", "1", "--appendonly", "yes"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: ${CC_POD_PREFIX}litellm-redisdata
---
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}litellm
  labels:
    app: ${CC_POD_PREFIX}litellm
spec:
  restartPolicy: Always
  containers:
    - name: litellm
      image: ${CC_REGISTRY_GHCR}/berriai/litellm-database:main-stable
      args: ["--config", "/app/config.yaml", "--port", "4000"]
      ports:
        - containerPort: 4000
          hostPort: ${CC_LITELLM_PORT}
          hostIP: 127.0.0.1
      env:
        - name: LITELLM_MASTER_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: LITELLM_MASTER_KEY}
        # NEVER change after first run: it encrypts every stored LiteLLM
        # virtual key. A restore under a different salt leaves the rows
        # present but undecryptable.
        - name: LITELLM_SALT_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: LITELLM_SALT_KEY}
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: DATABASE_URL}
        # The user's own upstream credential, referenced as os.environ/
        # from config.yaml so it never lands in the ConfigMap.
        - name: CC_LLM_API_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: CC_LLM_API_KEY}
        # Same credential unless the user's embeddings live on a different
        # server (make-secrets.sh copies CC_LLM_API_KEY when unset).
        - name: CC_EMBED_API_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: CC_EMBED_API_KEY}
        # Admin-UI login. make-secrets.sh fills LiteLLM's own defaults
        # (admin / master key) when UI_USERNAME/UI_PASSWORD are unset in .env.
        - name: UI_USERNAME
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: UI_USERNAME}
        - name: UI_PASSWORD
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: UI_PASSWORD}
        - name: REDIS_HOST
          value: ${CC_POD_PREFIX}litellm-redis
        - name: REDIS_PORT
          value: "6379"
        - name: STORE_MODEL_IN_DB
          value: "True"
        # !! ANTHROPIC_API_KEY IS DELIBERATELY ABSENT — DO NOT ADD IT !!
        # LiteLLM injects it as a last-resort fallback in two places that
        # silently bill a pay-per-token key: the /anthropic/* passthrough
        # (injected headers BEAT the client's forwarded Authorization), and
        # any model row with neither api_key nor credential. With it absent
        # both fail loudly instead.
      volumeMounts:
        - name: config
          mountPath: /app/config.yaml
          subPath: config.yaml
          readOnly: true
  volumes:
    - name: config
      configMap:
        name: ${CC_POD_PREFIX}litellm-config
