# ============================================================================
# cc-speech — self-hosted speech engine (Speaches: faster-whisper STT + Kokoro
# TTS), SINGLE-NODE profile. Played when CC_ENABLE_SPEECH=1 (the default).
#
#   It backs the two speech aliases the cockpit's voice features address
#   through LiteLLM — cc-tts (/v1/audio/speech) and cc-stt
#   (/v1/audio/transcriptions). Either alias may point somewhere else instead
#   (an operator with hosted Whisper-convention models registers cc-stt at
#   those); CC_ENABLE_SPEECH=0 means BOTH aliases are yours to point elsewhere.
#
#   Played in the LLM phase alongside LiteLLM, before the model-catalog pause,
#   so the re-run can probe the aliases with a real synthesis + transcription.
#
#   Models are HF-hub snapshots in a PVC (the container's HF cache, uid 1000).
#   PRELOAD_MODELS pulls them on first boot — from huggingface.co or the
#   CC_HF_ENDPOINT mirror; with no egress at all, pre-place the snapshots in
#   the volume (deploy/AIRGAP.md). Nothing here holds a credential: the
#   engine's API key is unset and only this host's loopback can reach it.
# ============================================================================
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${CC_POD_PREFIX}speech-models
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}speech
  labels:
    app: ${CC_POD_PREFIX}speech
spec:
  restartPolicy: Always
  enableServiceLinks: false
  containers:
    - name: speech
      image: ${CC_REGISTRY_GHCR}/speaches-ai/speaches:0.8.3-cpu
      env:
        - name: PRELOAD_MODELS
          value: '["${CC_SPEECH_TTS_MODEL}", "${CC_SPEECH_STT_MODEL}"]'
        - name: HF_ENDPOINT
          value: ${CC_HF_ENDPOINT}
        - name: HF_HUB_CACHE
          value: /home/ubuntu/.cache/huggingface/hub
      ports:
        - containerPort: 8000
          hostPort: ${CC_SPEECH_PORT}
          hostIP: 127.0.0.1
      volumeMounts:
        - name: models
          mountPath: /home/ubuntu/.cache/huggingface/hub
      # podman turns livenessProbe into a container healthcheck (no
      # startupProbe here). The first boot downloads ~1GB of models before
      # /health answers, so the budget is 30 minutes — a restart mid-download
      # would only start it over. setup.sh polls for the real answer.
      livenessProbe:
        httpGet: {path: /health, port: 8000}
        initialDelaySeconds: 60
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 60
      resources:
        requests: {memory: 1Gi, cpu: 250m}
        limits: {memory: 4Gi, cpu: "2"}
  volumes:
    - name: models
      persistentVolumeClaim:
        claimName: ${CC_POD_PREFIX}speech-models
