# ============================================================================
# n8n — OPTIONAL, and separate on purpose.
#
#   n8n exists in Central Command for exactly one reason: it holds the Gmail OAuth
#   credential behind the email façade, so Central Command never sees it. If the
#   user picks no n8n-backed integration at setup, none of this is played and
#   the install is two containers lighter.
#
#   N8N_ENCRYPTION_KEY must NEVER change after the first run. It decrypts the
#   stored Gmail credential; starting the same database under a different key
#   leaves the credential row present but undecryptable, costing a re-consent
#   and a Google Cloud redirect-URI change. make-secrets.sh reads it from .env
#   and generates one only when it is absent.
#
#   Single instance, default `regular` execution mode — the façade is one
#   synchronous webhook and a queue buys nothing.
#
#   Rendered by render.sh alongside stack.yaml; played separately:
#     podman kube play --network "$CC_NETWORK" optional-n8n.yaml
# ============================================================================
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${CC_POD_PREFIX}n8n-pgdata
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${CC_POD_PREFIX}n8n-data
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 2Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}n8n-db
  labels:
    app: ${CC_POD_PREFIX}n8n-db
spec:
  restartPolicy: Always
  containers:
    - name: postgres
      image: ${CC_REGISTRY_DOCKERIO}/library/postgres:16
      # Deliberately NOT envFrom the whole secret — that would inject
      # N8N_ENCRYPTION_KEY into a database container with no use for it.
      env:
        - name: POSTGRES_USER
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}n8n, key: N8N_DB_USER}
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}n8n, key: N8N_DB_PASSWORD}
        - name: POSTGRES_DB
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}n8n, key: N8N_DB_NAME}
        - name: PGDATA
          value: /var/lib/postgresql/data/pgdata
      volumeMounts:
        - name: data
          mountPath: /var/lib/postgresql/data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: ${CC_POD_PREFIX}n8n-pgdata
---
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}n8n
  labels:
    app: ${CC_POD_PREFIX}n8n
spec:
  restartPolicy: Always
  containers:
    - name: n8n
      image: ${CC_REGISTRY_DOCKERIO}/n8nio/n8n:2.29.0
      ports:
        - containerPort: 5678
          hostPort: ${CC_N8N_PORT}
          hostIP: 127.0.0.1
      env:
        - name: DB_TYPE
          value: postgresdb
        - name: DB_POSTGRESDB_HOST
          value: ${CC_POD_PREFIX}n8n-db
        - name: DB_POSTGRESDB_PORT
          value: "5432"
        - name: DB_POSTGRESDB_DATABASE
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}n8n, key: N8N_DB_NAME}
        - name: DB_POSTGRESDB_USER
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}n8n, key: N8N_DB_USER}
        - name: DB_POSTGRESDB_PASSWORD
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}n8n, key: N8N_DB_PASSWORD}
        # NEVER change after first run — see the header.
        - name: N8N_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}n8n, key: N8N_ENCRYPTION_KEY}
        - name: N8N_HOST
          value: localhost
        - name: N8N_PORT
          value: "5678"
        - name: N8N_PROTOCOL
          value: http
        - name: WEBHOOK_URL
          value: http://localhost:${CC_N8N_PORT}/
        - name: N8N_DEFAULT_BINARY_DATA_MODE
          value: filesystem
        - name: N8N_SECURE_COOKIE
          value: "false"
        - name: N8N_LOG_LEVEL
          value: info
        - name: N8N_RUNNERS_ENABLED
          value: "true"
        - name: N8N_BLOCK_ENV_ACCESS_IN_NODE
          value: "false"
      volumeMounts:
        - name: data
          mountPath: /home/node/.n8n
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: ${CC_POD_PREFIX}n8n-data
