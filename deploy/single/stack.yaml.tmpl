# ============================================================================
# Central Command — SINGLE-NODE profile for `podman kube play`.
#
#   This is the GIFTABLE deploy target (design record
#   docs/superpowers/specs/2026-08-21-setup-onboarding-design.md, decision 5).
#   It is DERIVED from deploy/k3s/ with every homelab specific factored out:
#   no two-node placement (nodeSelector/affinity/tolerations), no Tailscale,
#   no workstation llama fleet, no sandbox/crawler/vlogs. The operator's two-node k3s
#   deployment is untouched and is NOT this.
#
#   ── HOW THE PIECES FIND EACH OTHER ──────────────────────────────────────
#   `podman kube play` does not implement Services. What it DOES give us is
#   aardvark-dns on a user-defined network, where every POD is resolvable by
#   its pod name (verified on podman 4.9.3: `getent hosts <podname>` from a
#   container in a sibling pod resolves). So there are no Service objects here
#   at all — the pod NAME is the DNS name, which is why ${CC_POD_PREFIX} is
#   applied to both the metadata.name and every reference to it. Change one,
#   change both, or the graph stops finding Neo4j.
#
#   Host reachability is plain hostPort on 127.0.0.1 — podman publishes
#   hostPort by default (`--publish-all` is only needed for bare
#   containerPort). Same loopback contract the app already assumes, so no
#   CC_* endpoint in .env needs a hostname.
#
#   ── WHAT IS DELIBERATELY NOT HERE ───────────────────────────────────────
#   * No readiness/liveness probes. podman turns livenessProbe into a
#     container healthcheck and ignores readinessProbe entirely, so half of
#     them would be decoration. verify.sh polls for real instead.
#   * No `strategy: Recreate` / Deployments. Plain Pods: one node, one
#     replica, and Pods are the shape podman kube play handles best.
#   * No LITELLM_SALT_KEY generation. It is read from .env by make-secrets.sh
#     and must NEVER change after first run — it encrypts the stored LiteLLM
#     virtual keys, and a restore under a different salt leaves the rows
#     present but undecryptable.
#
#
#   ── THIS IS THE CORE HALF ───────────────────────────────────────────────
#   LiteLLM and its database/redis live in stack-llm.yaml.tmpl, played FIRST
#   (2026-08-25, LiteLLM-first setup). This file is the one that carries
#   ${CC_EMBED_DIM} — the graph may not be created before that dimension has
#   been measured through the cc-embedding alias, because it is written into
#   the Neo4j vector index and is effectively permanent.
#
#   Rendered by render.sh (envsubst with an EXPLICIT variable list, so the
#   ${...} refs that graphiti expands from its own container env survive).
# ============================================================================
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${CC_POD_PREFIX}graphiti-config
data:
  config.yaml: |
    # Graphiti MCP config for the single-node profile.
    # Schema is the one zepai/knowledge-graph-mcp:1.0.2-standalone parses.
    # ${VAR} refs below are expanded by GRAPHITI at runtime from container
    # env — render.sh's envsubst is given an explicit variable list precisely
    # so these survive rendering.
    server:
      transport: "http"
      host: "0.0.0.0"
      port: 8000

    llm:
      # "openai" is the WIRE PROTOCOL, not the vendor.
      provider: "openai"
      # The BRIDGED alias — see the long note on graphiti-llm above.
      model: "graphiti-llm"
      max_tokens: 4096
      # PINNED. Unset does not mean deterministic: the param is OMITTED from
      # the request and the SERVER's default applies (commonly temp 1.0), so
      # entity dedup and the CONTRADICTION pass that RETIRES existing facts
      # would run on stochastic sampling.
      temperature: 0.0
      providers:
        openai:
          api_key: ${GRAPHITI_LLM_API_KEY}
          # Decorative: the MCP factory's `openai` case builds its LLM config
          # without base_url, so the endpoint actually comes from
          # OPENAI_BASE_URL in the pod env. Stated here for intent only.
          api_url: ${LLM_API_URL}

    embedder:
      provider: "openai"
      model: "cc-embedding"
      dimensions: ${CC_EMBED_DIM}
      providers:
        openai:
          api_key: ${EMBEDDER_API_KEY}
          api_url: ${EMBEDDER_API_URL}

    database:
      provider: "neo4j"
      providers:
        neo4j:
          uri: ${NEO4J_URI}
          username: ${NEO4J_USER:neo4j}
          # No default on purpose — fail loud rather than fall back to the
          # upstream template's `demodemo`.
          password: ${NEO4J_PASSWORD}
          database: ${NEO4J_DATABASE:neo4j}
          use_parallel_runtime: ${USE_PARALLEL_RUNTIME:false}

    graphiti:
      group_id: ${GRAPHITI_GROUP_ID:main}
      episode_id_prefix: ${EPISODE_ID_PREFIX:}
      user_id: ${USER_ID:operator}
      # Upstream's default ontology has no type for a HUMAN BEING, so every
      # person lands as a bare `Entity` while orgs type correctly. Person is
      # declared FIRST so it beats the "use as last resort" types below.
      entity_types:
        - name: "Person"
          description: "An individual human being — family, friends, colleagues, contacts. Use the person's canonical full name as the entity name, never a role or pronoun ('the operator'). A NAME IS NOT A PERSON: a bare surname, maiden name, married name, nickname or alias must NEVER become an entity of its own, because that invents a second human who does not exist. Do still RECORD what someone is called — attach it to the person it belongs to, as a fact about that one person. Drop the name, never the fact."
        - name: "Preference"
          description: "User preferences, choices, opinions, or selections (PRIORITIZE over most other types except User/Assistant)"
        - name: "Requirement"
          description: "Specific needs, features, or functionality that must be fulfilled"
        - name: "Procedure"
          description: "Standard operating procedures and sequential instructions"
        - name: "Location"
          description: "Physical or virtual places where activities occur"
        - name: "Event"
          description: "Time-bound activities, occurrences, or experiences"
        - name: "Organization"
          description: "Companies, institutions, groups, or formal entities"
        - name: "Document"
          description: "Information content in various forms (books, articles, reports, etc.)"
        - name: "Topic"
          description: "Subject of conversation, interest, or knowledge domain (use as last resort)"
        - name: "Object"
          description: "Physical items, tools, devices, or possessions (use as last resort)"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${CC_POD_PREFIX}pgdata
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${CC_POD_PREFIX}neo4j-data
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 10Gi
---
# ── THE SPINE ────────────────────────────────────────────────────────────────
# 5442, never 5432. The port is baked into .env, .env.example, config.py's
# default and every recipe in the docs; changing it buys nothing and breaks
# all of them.
#
# schema.sql arrives as the ${CC_POD_PREFIX}schema-sql ConfigMap, which
# render.sh generates from central_command/db/schema.sql (separately, WITHOUT
# envsubst — the SQL contains `$` and would be mangled). It runs on a FRESH
# database only; nothing applies it at runtime.
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}postgres
  labels:
    app: ${CC_POD_PREFIX}postgres
spec:
  restartPolicy: Always
  containers:
    - name: postgres
      image: ${CC_REGISTRY_DOCKERIO}/library/postgres:16
      env:
        - name: POSTGRES_USER
          value: central_command
        - name: POSTGRES_PASSWORD
          value: central_command
        - name: POSTGRES_DB
          value: central_command
        # Keep the data directory in a SUBdirectory: the volume root is
        # root-owned and initdb refuses a non-empty/oddly-owned root.
        - name: PGDATA
          value: /var/lib/postgresql/data/pgdata
      ports:
        - containerPort: 5432
          hostPort: ${CC_PG_PORT}
          hostIP: 127.0.0.1
      volumeMounts:
        - name: pgdata
          mountPath: /var/lib/postgresql/data
        - name: schema
          mountPath: /docker-entrypoint-initdb.d
          readOnly: true
  volumes:
    - name: pgdata
      persistentVolumeClaim:
        claimName: ${CC_POD_PREFIX}pgdata
    - name: schema
      configMap:
        name: ${CC_POD_PREFIX}schema-sql
---
# ── THE GRAPH ────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}neo4j
  labels:
    app: ${CC_POD_PREFIX}neo4j
spec:
  restartPolicy: Always
  # Kubernetes injects a service-discovery env var for every Service in the
  # namespace, and the Neo4j entrypoint turns EVERY NEO4J_-prefixed variable
  # into a config setting — so NEO4J_PORT_7687_TCP_PORT becomes the setting
  # `PORT.7687.TCP.PORT` and startup dies with "Unrecognized setting".
  #
  # podman kube play implements no Services and injects no service links, so
  # this is inert HERE. It is kept anyway: it costs nothing, it documents the
  # trap, and it keeps the manifest correct if it is ever applied to a real
  # cluster. Do NOT "fix" the underlying issue with
  # server.config.strict_validation.enabled=false — that silences the symptom
  # and leaves junk settings parsed.
  enableServiceLinks: false
  containers:
    - name: neo4j
      image: ${CC_REGISTRY_DOCKERIO}/library/neo4j:5.26.2
      env:
        - name: NEO4J_AUTH
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}neo4j, key: NEO4J_AUTH}
        - name: NEO4J_server_memory_heap_initial__size
          value: 512m
        - name: NEO4J_server_memory_heap_max__size
          value: 1G
        - name: NEO4J_server_memory_pagecache_size
          value: 512m
      ports:
        # Published on LOOPBACK, unlike the k3s profile where Neo4j is
        # ClusterIP-only behind a port-forward unit. On one machine the
        # operator curation path (integrations/neo4j_writer.py) talks bolt
        # directly, and a loopback bind is the whole of what it needs.
        - containerPort: 7687
          hostPort: ${CC_NEO4J_BOLT_PORT}
          hostIP: 127.0.0.1
        - containerPort: 7474
          hostPort: ${CC_NEO4J_HTTP_PORT}
          hostIP: 127.0.0.1
      volumeMounts:
        - name: data
          mountPath: /data
        - name: logs
          mountPath: /logs
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: ${CC_POD_PREFIX}neo4j-data
    - name: logs
      emptyDir: {}
---
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}graphiti
  labels:
    app: ${CC_POD_PREFIX}graphiti
spec:
  restartPolicy: Always
  enableServiceLinks: false
  containers:
    - name: graphiti
      # LOCALLY BUILT by build-graphiti-image.sh. podman tags a local build
      # `localhost/<name>` and RESOLVES that prefix out of local storage, so
      # `localhost/` is the correct ref form for kube play — the opposite of
      # the k3s profile, where the kubelet normalises a bare name to
      # docker.io/library/ and a localhost/ ref is invisible to it.
      image: localhost/cc-graphiti:${CC_GRAPHITI_TAG}
      imagePullPolicy: IfNotPresent
      env:
        - name: CONFIG_PATH
          value: /app/mcp/config/config.yaml
        - name: NEO4J_URI
          value: bolt://${CC_POD_PREFIX}neo4j:7687
        - name: NEO4J_USER
          value: neo4j
        - name: NEO4J_PASSWORD
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}neo4j, key: NEO4J_PASSWORD}
        - name: GRAPHITI_LLM_API_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}graphiti, key: GRAPHITI_LLM_API_KEY}
        - name: EMBEDDER_API_URL
          value: http://${CC_POD_PREFIX}litellm:4000/v1
        # Decorative for the LLM (the factory ignores it) but the config file
        # references it, so give it a value rather than let it expand empty.
        - name: LLM_API_URL
          value: http://${CC_POD_PREFIX}litellm:4000/v1
        - name: EMBEDDER_API_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}graphiti, key: EMBEDDER_API_KEY}
        # The RERANKER's endpoint, and the LLM's. graphiti_core builds its
        # cross-encoder as OpenAIRerankerClient() with no config, so the
        # openai SDK falls back to these two vars — the only seam available
        # without patching the image. OPENAI_API_KEY is REQUIRED even though
        # it is not the embedder's: Graphiti.__init__ unconditionally
        # constructs the reranker client, which raises without a key.
        - name: OPENAI_BASE_URL
          value: http://${CC_POD_PREFIX}litellm:4000/v1
        - name: OPENAI_API_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}graphiti, key: RERANKER_API_KEY}
        # GRAPHITI_RERANK_MODEL is DELIBERATELY UNSET here: it selects the
        # true cross-encoder path through LiteLLM /rerank, which needs a
        # rerank-capable model this profile does not assume the user has.
        # Unset falls back to upstream's logprob-classifier reranker against
        # OPENAI_BASE_URL, addressing the `gpt-4.1-nano` alias the LiteLLM
        # config above registers for exactly this. See README.md "Reranking".
        - name: GRAPHITI_TELEMETRY_ENABLED
          value: "false"
        - name: SEMAPHORE_LIMIT
          value: "3"
      ports:
        - containerPort: 8000
          hostPort: ${CC_GRAPHITI_PORT}
          hostIP: 127.0.0.1
      volumeMounts:
        - name: config
          mountPath: /app/mcp/config/config.yaml
          subPath: config.yaml
          readOnly: true
  volumes:
    - name: config
      configMap:
        name: ${CC_POD_PREFIX}graphiti-config
