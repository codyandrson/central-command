# ============================================================================
# cc-crawler — browser-rendering crawl service (rung 2 of docs ingestion),
# SINGLE-NODE profile. Played when CC_ENABLE_CRAWLER=1 (the default).
#
#   Derived from deploy/k3s/70-crawler.yaml: the Deployment + LoadBalancer
#   Service collapse to a plain Pod with a loopback hostPort, and the
#   chromebox nodeAffinity disappears with the second node. The resource
#   numbers are the k3s ones unchanged — 3Gi is what a Playwright Chromium
#   under load actually needs, and it is the reason this is opt-OUT-able.
#
#   Image is LOCALLY BUILT (build-crawler-image.sh) and therefore
#   `localhost/`-prefixed with imagePullPolicy: IfNotPresent — podman resolves
#   that prefix out of local storage and never asks a registry. (The k3s file
#   says docker.io/library/ for the exact opposite reason; see that script.)
#
#   The LLM credential is the LiteLLM MASTER key from the litellm secret,
#   which only the opt-in `filter: "llm"` crawl mode uses; without it that
#   request falls back to heuristic pruning rather than failing. A virtual key
#   scoped to cc-default would be tighter — the master key is what this
#   profile already has at play time.
# ============================================================================
apiVersion: v1
kind: Pod
metadata:
  name: ${CC_POD_PREFIX}crawler
  labels:
    app: ${CC_POD_PREFIX}crawler
spec:
  restartPolicy: Always
  enableServiceLinks: false
  containers:
    - name: crawler
      image: localhost/cc-crawler:1
      imagePullPolicy: IfNotPresent
      env:
        - name: LLM_BASE_URL
          value: http://${CC_POD_PREFIX}litellm:4000/v1
        - name: LLM_MODEL
          value: cc-default
        - name: LLM_API_KEY
          valueFrom:
            secretKeyRef: {name: ${CC_POD_PREFIX}litellm, key: LITELLM_MASTER_KEY}
      ports:
        - containerPort: 8091
          hostPort: ${CC_CRAWLER_PORT}
          hostIP: 127.0.0.1
      # podman turns livenessProbe into a container healthcheck (and ignores
      # readinessProbe entirely), so only this one is kept. Generous on
      # purpose: a crawl holds the process-wide lock and Chromium is slow to
      # come up at all — verify.sh polls for the real answer.
      livenessProbe:
        httpGet: {path: /healthz, port: 8091}
        initialDelaySeconds: 30
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 6
      resources:
        requests: {memory: 512Mi, cpu: 250m}
        limits: {memory: 3Gi, cpu: "2"}
