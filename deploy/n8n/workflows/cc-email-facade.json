        "jsCode": "const TOKEN = '__CC_EMAIL_FACADE_TOKEN__';\nconst item = $input.first().json;\nconst hdr = item.headers || {};\nconst supplied = hdr['x-cc-token'];\nif (supplied !== TOKEN) { throw new Error('cc-email-facade - unauthorized'); }\nconst body = item.body || {};\nif (!body || !body.mode) { throw new Error('cc-email-facade - missing mode'); }\n// Attachments are never requested through this facade: Central Command\n// ingests text only (attachments are extracted at the gateway).\nif (body.include_attachments) { throw new Error('cc-email-facade - attachments are not served through this facade'); }\nreturn [{ json: body }];\n"
      }
