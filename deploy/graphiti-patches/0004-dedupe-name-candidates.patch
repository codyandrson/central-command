+def _name_tokens(name: str) -> frozenset[str]:
+    """The words of a name, lowercased, a possessive's `s` dropped."""
+    import re
+
+    words = re.split(r'[^a-z0-9]+', re.sub(r"['\u2019]s\b", '', name.lower()))
+    return frozenset(word for word in words if word)
+
+
+def _rank_name_candidates(name: str, rows: list[tuple[str, str]], limit: int) -> list[str]:
+    """Order `(uuid, name)` rows for one extracted name: only a name whose words all
+    appear in the other (either way round) counts, closest word-overlap first."""
+    wanted = _name_tokens(name)
+    if not wanted:
+        return []
+    scored: list[tuple[float, str]] = []
+    for uuid, other in rows:
+        have = _name_tokens(other or '')
+        if have and (wanted <= have or have <= wanted):
+            scored.append((len(wanted & have) / len(wanted | have), uuid))
+    scored.sort(key=lambda pair: (-pair[0], pair[1]))
+    return [uuid for _, uuid in scored[:limit]]
+
+
+async def _name_candidate_search(
+    clients: GraphitiClients,
+    extracted_nodes: list[EntityNode],
+) -> list[list[EntityNode]]:
+    """Existing entities of the same group whose NAME shares every word with the
